{
 "title": "Rephix 0.4 text-only recovery protocol",
 "registered": "2026-11-08, before any final-split seed was run; dev seeds 1 and 2 were used only to choose budgets",
 "contract": "docs/TEXT_RECOVERY.md#observation-contract",
 "decision_rule": {
  "alpha": 0.01,
  "bootstrap": 99,
  "max_relative_standard_error": 0.1
 },
 "success_criteria": {
  "S1_status": "every final run's status equals its case's expected_status (errors count as status 'error')",
  "S2_accuracy": "every run with status recovered_in_class has canonical_relative_l2_error <= 0.10",
  "S3_self_report": "every recovered run has canonical_relative_l2_error <= 2.5 * reported_relative_standard_error",
  "S4_coverage": "pooled 95% interval coverage over recovered runs lies in [0.90, 0.99]",
  "S5_behaviour": "every recovered run has test_mean_total_variation <= 0.02 on held-out contexts disjoint from queries",
  "S6_baseline": "MLE canonical error below the plug-in baseline in at least 80% of recovered runs",
  "S7_consistency": "median ratio of canonical error at full budget to error at 4x budget lies in [1.5, 2.7] (theory: 2); the 1/16 budget is expected to be flagged insufficient",
  "S8_boundary": "no out-of-class, greedy, undeclared-output or underdetermined run is labelled recovered_in_class",
  "S9_isolation": "zero opens of the private target directory by the recovery or reload processes, and every export reloads with max |log p difference| <= 1e-9"
 },
 "environment_variables": {
  "REPHIX_MODELS": "directory with pinned snapshots tinyllama-15M and smollm2-135m"
 },
